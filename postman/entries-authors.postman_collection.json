          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/authors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "authors"
              ]
            },
            "description": "**Esperado: 201**\n\nCrea el autor de prueba que usarán las siguientes peticiones.\n\nValidaciones del POST:\n- name: obligatorio, texto, 3-45 caracteres\n- surname: obligatorio, texto, 3-45 caracteres\n- email: formato email, máx. 100 caracteres",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Prueba\",\n  \"surname\": \"Postman\",\n  \"email\": \"prueba.postman@thebridgeschool.es\",\n  \"image\": \"https://randomuser.me/api/portraits/lego/1.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Crear autor duplicado → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/authors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "authors"
              ]
            },
            "description": "**Esperado: 409**\n\nEl email es UNIQUE en la BBDD: PostgreSQL devuelve el código 23505 y la API responde 409 Conflict.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Prueba\",\n  \"surname\": \"Postman\",\n  \"email\": \"prueba.postman@thebridgeschool.es\",\n  \"image\": \"https://randomuser.me/api/portraits/lego/1.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
